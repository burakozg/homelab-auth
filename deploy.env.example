# Deploy-time values for ./deploy. Copy to .deploy.env, which is gitignored.
#
# Nothing here is a secret, but all of it is real deployment topology — LAN
# addresses, ssh destinations, paths — which is exactly the class of value that
# must never land in a tracked file. The script reads every one of these as
# ${VAR:-placeholder}, so a clone with no .deploy.env still parses; it just
# points nowhere.

# The NAS host account. Always the ssh destination, never a container address.
NAS_SSH=deploy@nas.local
NAS_SSH_PORT=44

# Where this project's compose file lives on the NAS.
NAS_APP_DIR=/share/Container/homelab-auth

# docker is not on PATH for a non-interactive ssh session on this NAS.
NAS_DOCKER_BIN=/share/CACHEDEV1_DATA/.qpkg/container-station/bin/docker

# The Mac is arm64 and the NAS is amd64. Wrong arch is a silent
# "exec format error" at container start, long after the deploy reports success.
NAS_PLATFORM=linux/amd64

# QNAP's docker wrapper unconditionally overwrites $HOME into a root-owned
# directory. DOCKER_CONFIG is the one it leaves alone.
NAS_DOCKER_CONFIG=/tmp/.docker-deploy

# This container's own address on the Container Station macvlan. Every other
# app's Traefik forwardAuth config points at this address. Pick one not
# already taken by a sibling project.
APP_LAN_IP=10.0.0.2

# The macvlan Container Station created. Named here so a differently-named one
# is a config change rather than an edit to the compose template.
QNET=qnet-static-eth1-dc7e3a

# dnsmasq's own address on the same macvlan. Pick one not already taken by a
# sibling project or by this one's own APP_LAN_IP.
DNSMASQ_LAN_IP=10.0.0.3

# Where dnsmasq forwards anything that isn't *.home.arpa — normally the LAN
# gateway, since it's also this network's resolver.
UPSTREAM_DNS=10.0.0.10

# Traefik's existing qnet address (this project doesn't own or assign it —
# Traefik predates it). Every name under HOMELAB_DOMAIN that dnsmasq answers
# points here.
TRAEFIK_LAN_IP=10.0.0.4

# The shared internal domain every gated app's hostname lives under. Must
# match AUTH_COOKIE_DOMAIN (".${HOMELAB_DOMAIN}") and AUTH_LOGIN_URL in the
# NAS's own homelab-auth.env by hand — this variable only drives dnsmasq's
# side of it.
HOMELAB_DOMAIN=home.arpa
