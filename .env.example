# Secrets and per-deployment settings for the app itself. Copy to .env for
# local dev; .env is gitignored. See README.md for what each of these does.
#
# On the NAS specifically, this file is named homelab-auth.env, NOT .env —
# docker compose auto-loads a literal .env in the project directory for its
# OWN interpolation, which mangles a value containing "$" (a bcrypt hash)
# even with no ${...} reference to it anywhere in the compose file. See the
# comment on docker-compose.nas.yml's env_file: for the full story.

# The one admin username.
AUTH_USERNAME=admin

# Bcrypt hash of the admin password — never the plaintext. Generate/change it
# with: uv run python scripts/hash_password.py
AUTH_PASSWORD_HASH=

# Signs the session JWT/cookie. Generate one: openssl rand -hex 32
AUTH_SECRET_KEY=

# Cookie Domain attribute — shared across every subdomain under it, which is
# the whole point: one login covers every *.home.arpa admin panel. Replace
# with this fleet's real internal domain.
AUTH_COOKIE_DOMAIN=.home.arpa

# Session lifetime in days. A household convenience tool, not a high-security
# SaaS — long-lived by design.
AUTH_SESSION_DAYS=30

# Absolute origin this service is reachable at from a browser (no trailing
# slash) — e.g. http://auth.home.arpa. Required: /verify uses this to build
# an ABSOLUTE redirect Location when denying access. A relative "/login"
# would resolve against whichever *app* the browser was denied on, not this
# service, since Traefik relays /verify's response straight to that app's
# origin.
AUTH_LOGIN_URL=

TZ=Europe/Stockholm
