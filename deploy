#!/usr/bin/env bash
# Deploy homelab-auth to the NAS. Run it on the Mac.
#
#   ./deploy            build, ship, bring it up
#   ./deploy ship       build and ship only — nothing restarted
#   ./deploy apply      bring it up from what is already on the NAS
#   ./deploy render     write deploy-out/docker-compose.nas.yml and stop
#   ./deploy check      is it running, and reachable over the LAN
#   ./deploy logs       follow the container's log
#
# See homelab/README.md for the verb contract the sibling projects share.
set -euo pipefail

cd "$(dirname "$0")"
. ./deploy.lib.sh
nas_load_env "$PWD" "/share/Container/homelab-auth"

LIFECYCLE=compose
TAG="homelab-auth:0.1.0"
NAS_COMPOSE="docker-compose.nas.yml"
RENDERED="deploy-out/docker-compose.nas.yml"

# This container's own address on the Container Station macvlan — every other
# app's Traefik forwardAuth config points here. Required rather than
# defaulted: a wrong-but-plausible default would deploy onto whatever is
# already at that address.
# Note: no apostrophes in any :? message below — bash balances quote characters
# inside ${...} independently of the surrounding double quotes.
APP_LAN_IP="${APP_LAN_IP:?Set APP_LAN_IP in .deploy.env — the qnet address for this container}"

# Not a secret, and already named in docker-compose.nas.yml, so a default rather
# than a required var; override it if Container Station names the macvlan
# differently.
QNET="${QNET:-qnet-static-eth1-dc7e3a}"

# dnsmasq's own address on the macvlan — required for the same reason
# APP_LAN_IP is: a wrong-but-plausible default would silently deploy onto
# whatever already answers at that address.
DNSMASQ_LAN_IP="${DNSMASQ_LAN_IP:?Set DNSMASQ_LAN_IP in .deploy.env — the qnet address for the dnsmasq container}"

# Where dnsmasq forwards everything that isn't *.home.arpa — normally your
# LAN gateway, which is also this network's own resolver. Placeholder here,
# same reasoning as the other defaults in this file: override in .deploy.env.
UPSTREAM_DNS="${UPSTREAM_DNS:-10.0.0.10}"

# Traefik's own qnet address — the single target every name under
# HOMELAB_DOMAIN resolves to; Traefik tells apps apart by Host header, not by
# IP. Not this project's to assign (Traefik predates it), so a default rather
# than a required var, same reasoning as QNET above. Placeholder; override in
# .deploy.env.
TRAEFIK_LAN_IP="${TRAEFIK_LAN_IP:-10.0.0.4}"

# The shared internal domain every gated app's hostname lives under, and the
# cookie's Domain attribute — one place to change it rather than three.
# Whatever this is set to must also be set as AUTH_COOKIE_DOMAIN
# (".${HOMELAB_DOMAIN}") and reflected in AUTH_LOGIN_URL inside the NAS's own
# homelab-auth.env — deploy doesn't own that file (see do_ship), so it can't
# enforce the match, only document it.
HOMELAB_DOMAIN="${HOMELAB_DOMAIN:-home.arpa}"

PORT=8098
RENDERED_DNSMASQ_CONF="deploy-out/dnsmasq.conf"

do_render() {
  nas_render "$NAS_COMPOSE" "$RENDERED" \
    "s#QNET_PLACEHOLDER#${QNET}#g" \
    "s#NAS_APP_DIR_PLACEHOLDER#${NAS_APP_DIR}#g" \
    "s#APP_LAN_IP_PLACEHOLDER#${APP_LAN_IP}#" \
    "s#APP_MAC_PLACEHOLDER#$(nas_mac_for_ip "${APP_LAN_IP}")#" \
    "s#DNSMASQ_LAN_IP_PLACEHOLDER#${DNSMASQ_LAN_IP}#" \
    "s#DNSMASQ_MAC_PLACEHOLDER#$(nas_mac_for_ip "${DNSMASQ_LAN_IP}")#" \
    "s#DNSMASQ_CONF_PLACEHOLDER#${NAS_APP_DIR}/dnsmasq.conf#"
  nas_render "dnsmasq/dnsmasq.conf" "$RENDERED_DNSMASQ_CONF" \
    "s#UPSTREAM_DNS_PLACEHOLDER#${UPSTREAM_DNS}#" \
    "s#HOMELAB_DOMAIN_PLACEHOLDER#${HOMELAB_DOMAIN}#" \
    "s#TRAEFIK_TARGET_PLACEHOLDER#${TRAEFIK_LAN_IP}#"
}

do_ship() {
  nas_require_reachable
  nas_ship_image "$TAG" "$PWD"
  do_render
  nas_put "$RENDERED" "${NAS_APP_DIR}/docker-compose.nas.yml"
  nas_put "$RENDERED_DNSMASQ_CONF" "${NAS_APP_DIR}/dnsmasq.conf"
  # homelab-auth.env is never shipped: it holds every secret this service has
  # (the admin password hash and the session-signing key), it is gitignored
  # here, and it belongs to the NAS. Create it there once, by hand. NOT named
  # .env on the NAS — see the comment on env_file: in docker-compose.nas.yml
  # for why (compose's own auto-load of a literal .env mangles the "$"s in a
  # bcrypt hash even though nothing in this compose file references it).
  nas_exists "${NAS_APP_DIR}/homelab-auth.env" || {
    echo "!! ${NAS_APP_DIR}/homelab-auth.env does not exist on the NAS."
    echo "   Create it from .env.example before ./deploy apply, or the"
    echo "   container will start with login permanently unconfigured"
    echo "   (AUTH_SECRET_KEY / AUTH_PASSWORD_HASH unset -> every login 503s)."
  }
}

do_apply() {
  nas_require_reachable
  nas_ssh "cd '${NAS_APP_DIR}' && mkdir -p ${NAS_DOCKER_CONFIG} && ${NAS_DOCKER_ENV} '${NAS_DOCKER_BIN}' compose -f docker-compose.nas.yml up -d --force-recreate" \
    || die "compose up failed on the NAS."
  nas_ssh "cd '${NAS_APP_DIR}' && ${NAS_DOCKER_ENV} '${NAS_DOCKER_BIN}' compose -f docker-compose.nas.yml ps --format 'table {{.Name}}\t{{.Status}}'"
  # 72 tries at 5 s is six minutes. The default twelve is sized for a warm
  # start; this NAS is memory-tight and a recreate under load has been measured
  # taking far longer than a cold `docker start`. A probe that gives up early
  # reports a hard failure for a container that is merely starting, which is
  # worse than no probe because it aims the investigation at the wrong thing.
  nas_wait_reachable "homelab-auth" "http://${APP_LAN_IP}:${PORT}" "/healthz" "2.." 72
}

do_check() {
  nas_require_reachable
  nas_ssh "'${NAS_DOCKER_BIN}' ps --filter name=homelab-auth --format 'table {{.Names}}\t{{.Status}}'"
  # Probed from here, over the LAN, not from inside the container: a
  # healthcheck runs against localhost and passes happily while nothing on the
  # network can load the page.
  nas_probe "homelab-auth" "http://${APP_LAN_IP}:${PORT}" "/healthz"
}

do_logs() {
  nas_ssh -t "'${NAS_DOCKER_BIN}' logs -f --tail 200 homelab-auth"
}

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
}

NO_APPLY=false
VERB=""
for arg in "$@"; do
  nas_global_flag "$arg" && continue
  case "$arg" in
    ship|apply|check|render|logs|up|help) VERB="$arg" ;;
    *) die "unknown argument: ${arg}. Try ./deploy help" ;;
  esac
done

case "${VERB:-up}" in
  help)   usage ;;
  render) do_render ;;
  ship)   do_ship ;;
  apply)  do_apply ;;
  check)  do_check ;;
  logs)   do_logs ;;
  up)
    do_ship
    if [ "$NO_APPLY" = true ]; then
      echo "== shipped; not applying (--no-apply) =="
    else
      do_apply
    fi
    ;;
esac
